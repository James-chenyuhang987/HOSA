# 默认仅监听本机。局域网或公网部署需配置 HOSA_API_TOKEN 与允许的前端来源。
HOSA_HOST=127.0.0.1
HOSA_PORT=8787
# 不设置时优先读取 server/models.local.json，否则使用 models.example.json。
# HOSA_MODEL_CONFIG=server/models.local.json
# HOSA_API_TOKEN=replace-with-your-own-long-random-token
# 通过自己管理的隧道公开普通后端时设为 1，强制检查访问凭证。
# HOSA_PUBLIC_MODE=1
# npm run server:share 的独立端口及允许访问的网页来源：
# HOSA_SHARE_PORT=8788
# HOSA_PAGE_ORIGIN=https://james-chenyuhang987.github.io
HOSA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8787,http://localhost:8787
HOSA_REQUEST_TIMEOUT_MS=60000
HOSA_PROVIDER_TIMEOUT_MS=25000
HOSA_MAX_CONCURRENT=2
# 满载时最多排队的翻译请求，超过后返回 BUSY。
HOSA_MAX_QUEUE=8
# 每个连接凭证（本机无凭证时按连接地址）每分钟最多接受的翻译请求。
HOSA_RATE_LIMIT_PER_MINUTE=30
# 连接检测时用于验证一次真实模型推理的最长时间。
HOSA_HEALTH_PROBE_TIMEOUT_MS=15000
# 可选：OpenAI Transcription 兼容的本地方言 ASR，例如 Fun-ASR / Qwen3-ASR 服务。
# 只在你本机或受控内网运行；前端录音会经本后端转发到这个地址，不写入 HOSA 磁盘。
# HOSA_ASR_URL=http://127.0.0.1:8003/v1
# HOSA_ASR_MODEL=qwen3-asr-1.7b
# HOSA_ASR_LABEL=本地方言语音模型
# HOSA_ASR_TOKEN=local-asr-token
HOSA_ASR_TIMEOUT_MS=45000
HOSA_MAX_AUDIO_BYTES=12582912
# HOSA_HOST 设为非本机地址时，请把服务放在 HTTPS 反向代理后；不要直接暴露 HTTP。
# 模型 API 若要求密钥，在 models.local.json 对应项设置 apiKeyEnv 为该环境变量名。
# LOCAL_MODEL_API_KEY=your-model-server-key
